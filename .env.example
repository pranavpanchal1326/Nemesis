# Copy to .env before the first `docker compose up`.
# Every NEMESIS_* key maps to a field on nemesis.config.Settings (prefix
# NEMESIS_, nesting delimiter __). Unknown NEMESIS_* keys are rejected at
# startup by design.
#
# Keys WITHOUT the NEMESIS_ prefix are consumed by docker compose interpolation
# or by a sidecar container, not by the application. Pydantic ignores them.
#
# Every variable in the "deployment contract" block below is enumerated in
# backend/nemesis/deployment.py and checked by `nem parity`. That check is what
# makes the eventual Phase 1b cloud migration mechanical: the list of things a
# deployed environment must supply is written down and verified now, rather than
# discovered one outage at a time.

NEMESIS_APP_ENV=local
NEMESIS_LOG_LEVEL=INFO

# --- Deployment contract --------------------------------------------------
# Local values below. A deployed environment MUST override every one of these;
# `nem parity` fails if any is missing from this file or hardcoded in compose.

# Overridden per-service in docker-compose.yml; set here for host-side tooling
# (alembic, pytest) which reaches the containers via published ports.
NEMESIS_DATABASE_URL=postgresql+asyncpg://nemesis:nemesis@localhost:5432/nemesis
NEMESIS_REDIS_URL=redis://localhost:6379/0

# Read by the postgres container and by compose interpolation into the URL
# above. Local convenience value; rotation procedure in docs/SECRETS.md.
POSTGRES_PASSWORD=nemesis

# Ollama runs on the Windows host with exclusive use of the RTX 5060.
# `host.docker.internal` is a Docker Desktop construct and will NOT resolve in a
# cloud runtime — one of the two values most likely to be carried forward by
# accident (§12.4).
NEMESIS_OLLAMA__BASE_URL=http://host.docker.internal:11434
NEMESIS_OLLAMA__MODEL=llama3.1:8b

# CHANGE BEFORE ANY DEPLOYMENT. Local default is intentionally obvious, and
# app_env=pilot refuses to boot while it is still set.
NEMESIS_JWT_SECRET=dev-only-insecure-secret-change-me

# A wildcard here in front of citizen data is refused at startup under
# app_env=pilot. A stale localhost entry is not — that one is on you.
NEMESIS_CORS_ALLOW_ORIGINS=http://localhost:3000

# --- Observability (Phase 1a) ---------------------------------------------
# Off by default: a span exporter pointed at an absent collector retries forever
# on a background thread. `nem obs` sets both of these for you and recreates the
# backend services; `nem obs-down` puts them back.
NEMESIS_OTEL__ENABLED=false
NEMESIS_OTEL__ENDPOINT=

# Grafana, in the `obs` compose profile. Local-only credentials — dashboards
# disclose traffic patterns and error rates, so this is a real secret anywhere
# that is not a laptop.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Feature flags (Phase 1a) ---------------------------------------------
# reload_interval_seconds is the honest latency of a kill switch: a change takes
# effect within this window, not instantly.
NEMESIS_FLAGS__ENABLED=true
NEMESIS_FLAGS__RELOAD_INTERVAL_SECONDS=5

# --- Pipeline tunables (Blueprint §13.5, §14.3) ---------------------------
# Stated defaults, not tuned constants. Bias conservative: a false-positive
# merge suppresses a genuine citizen report.
NEMESIS_DEDUP__MERGE_THRESHOLD=0.85
NEMESIS_DEDUP__INVESTIGATE_THRESHOLD=0.65
NEMESIS_DEDUP__GEO_RADIUS_METERS=50
NEMESIS_DEDUP__TIME_WINDOW_HOURS=72

# --- Ingestion & rate limiting (Phase 3, §26.1 / §26.4) -------------------
# Caps are enforced while the request body streams, not after it has been read.
# Content types are matched against sniffed magic bytes; the Content-Type a
# client sends is ignored entirely (§25.1).
NEMESIS_INGEST__MAX_UPLOAD_BYTES=15728640
NEMESIS_INGEST__MAX_DESCRIPTION_CHARS=1000

# Tiers are resolved per tenant plan. Provisional: Phase 6 replaces this map
# with versioned, effective-dated policy data.
#
# fail_open=true is a deliberate, documented decision (ADR-0017): when Redis is
# unreachable the limiter allows the request and counts it, because the thing
# being limited is a citizen reporting a hazard and §11.3's device-velocity
# detection is an independent control that does not depend on Redis.
NEMESIS_RATE_LIMIT__ENABLED=true
NEMESIS_RATE_LIMIT__FAIL_OPEN=true
