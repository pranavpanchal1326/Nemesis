{
  "name": "municipality",
  "version": "1.0.0",
  "description": "An Indian urban local body: wards, civic defect categories, a monsoon window, and a six-day working week.",
  "locales": ["en", "hi", "mr"],

  "calendars": [
    {
      "code": "civic-standard",
      "name": "Standard municipal working week",
      "is_default": true,
      "working_hours": {
        "1": [{ "start": "10:00", "end": "13:30" }, { "start": "14:15", "end": "17:45" }],
        "2": [{ "start": "10:00", "end": "13:30" }, { "start": "14:15", "end": "17:45" }],
        "3": [{ "start": "10:00", "end": "13:30" }, { "start": "14:15", "end": "17:45" }],
        "4": [{ "start": "10:00", "end": "13:30" }, { "start": "14:15", "end": "17:45" }],
        "5": [{ "start": "10:00", "end": "13:30" }, { "start": "14:15", "end": "17:45" }],
        "6": [{ "start": "10:00", "end": "13:30" }]
      },
      "exceptions": [
        {
          "starts_on": "2026-06-10",
          "ends_on": "2026-09-30",
          "label": "monsoon",
          "is_working": true,
          "sla_multiplier": "1.600",
          "source": "IMD south-west monsoon onset/withdrawal normals for the west coast"
        },
        {
          "starts_on": "2026-10-19",
          "ends_on": "2026-10-21",
          "label": "Diwali",
          "is_working": false,
          "source": "State gazette holiday notification"
        }
      ]
    },
    {
      "code": "control-room",
      "name": "Emergency control room",
      "is_continuous": true
    }
  ],

  "departments": [
    {
      "code": "OPS",
      "name": "Municipal Operations",
      "kind": "directorate",
      "is_assignable": false,
      "translations": { "hi": "नगर संचालन", "mr": "नगर परिचालन" }
    },
    {
      "code": "PW",
      "name": "Public Works",
      "kind": "department",
      "parent_code": "OPS",
      "calendar_code": "civic-standard",
      "translations": { "hi": "लोक निर्माण", "mr": "सार्वजनिक बांधकाम" }
    },
    {
      "code": "SWM",
      "name": "Solid Waste Management",
      "kind": "department",
      "parent_code": "OPS",
      "calendar_code": "civic-standard",
      "translations": { "hi": "ठोस अपशिष्ट प्रबंधन", "mr": "घनकचरा व्यवस्थापन" }
    },
    {
      "code": "WATER",
      "name": "Water Supply and Sewerage",
      "kind": "department",
      "parent_code": "OPS",
      "calendar_code": "civic-standard",
      "translations": { "hi": "जल आपूर्ति एवं मलनिकास", "mr": "पाणीपुरवठा व मलनिस्सारण" }
    },
    {
      "code": "ELEC",
      "name": "Street Lighting",
      "kind": "department",
      "parent_code": "OPS",
      "calendar_code": "civic-standard",
      "translations": { "hi": "पथ प्रकाश", "mr": "पथदिवे" }
    },
    {
      "code": "EMG",
      "name": "Emergency Response Cell",
      "kind": "cell",
      "parent_code": "OPS",
      "calendar_code": "control-room",
      "translations": { "hi": "आपातकालीन प्रतिक्रिया कक्ष", "mr": "आपत्कालीन प्रतिसाद कक्ष" }
    }
  ],

  "shifts": [
    {
      "department_code": "EMG",
      "code": "night",
      "name": "Night control room",
      "weekdays": [1, 2, 3, 4, 5, 6, 7],
      "starts_at": "20:00",
      "ends_at": "08:00"
    },
    {
      "department_code": "SWM",
      "code": "early",
      "name": "Early collection round",
      "weekdays": [1, 2, 3, 4, 5, 6],
      "starts_at": "06:00",
      "ends_at": "10:00"
    }
  ],

  "zones": [
    { "code": "CITY", "name": "City", "kind": "city" },
    { "code": "Z-EAST", "name": "East Zone", "kind": "zone", "parent_code": "CITY" },
    { "code": "Z-WEST", "name": "West Zone", "kind": "zone", "parent_code": "CITY" },
    { "code": "W-01", "name": "Ward 1", "kind": "ward", "parent_code": "Z-EAST" },
    { "code": "W-02", "name": "Ward 2", "kind": "ward", "parent_code": "Z-EAST" },
    { "code": "W-03", "name": "Ward 3", "kind": "ward", "parent_code": "Z-WEST" },
    { "code": "W-04", "name": "Ward 4", "kind": "ward", "parent_code": "Z-WEST" }
  ],

  "taxonomy": [
    {
      "key": "roads",
      "display_name": "Roads and footpaths",
      "is_selectable": false,
      "icon": "road",
      "sort_order": 10,
      "routing_hints": { "department_code": "PW" },
      "translations": { "hi": "सड़क और फुटपाथ", "mr": "रस्ते व पदपथ" }
    },
    {
      "key": "pothole",
      "parent_key": "roads",
      "display_name": "Pothole",
      "icon": "pothole",
      "sort_order": 11,
      "severity_semantics": { "floor": 2.0, "multiplier": 1.0 },
      "routing_hints": { "department_code": "PW", "default_sla_tier": "medium" },
      "translations": { "hi": "गड्ढा", "mr": "खड्डा" }
    },
    {
      "key": "footpath_damage",
      "parent_key": "roads",
      "display_name": "Damaged footpath",
      "sort_order": 12,
      "routing_hints": { "department_code": "PW", "default_sla_tier": "low" },
      "translations": { "hi": "क्षतिग्रस्त फुटपाथ", "mr": "खराब पदपथ" }
    },
    {
      "key": "open_manhole",
      "parent_key": "roads",
      "display_name": "Open or missing manhole cover",
      "sort_order": 13,
      "severity_semantics": { "floor": 8.0, "multiplier": 1.0, "bypasses_scoring": true },
      "routing_hints": { "department_code": "EMG", "default_sla_tier": "urgent" },
      "translations": { "hi": "खुला मैनहोल", "mr": "उघडे मॅनहोल" }
    },
    {
      "key": "waste",
      "display_name": "Waste and sanitation",
      "is_selectable": false,
      "sort_order": 20,
      "routing_hints": { "department_code": "SWM" },
      "translations": { "hi": "कचरा और स्वच्छता", "mr": "कचरा व स्वच्छता" }
    },
    {
      "key": "garbage_pile",
      "parent_key": "waste",
      "display_name": "Uncollected garbage",
      "icon": "waste",
      "sort_order": 21,
      "routing_hints": { "department_code": "SWM", "default_sla_tier": "medium" },
      "translations": { "hi": "बिना उठाया कचरा", "mr": "न उचललेला कचरा" }
    },
    {
      "key": "dead_animal",
      "parent_key": "waste",
      "display_name": "Dead animal",
      "sort_order": 22,
      "severity_semantics": { "floor": 5.0, "multiplier": 1.0 },
      "routing_hints": { "department_code": "SWM", "default_sla_tier": "high" },
      "translations": { "hi": "मृत पशु", "mr": "मृत जनावर" }
    },
    {
      "key": "water",
      "display_name": "Water and drainage",
      "is_selectable": false,
      "sort_order": 30,
      "routing_hints": { "department_code": "WATER" },
      "translations": { "hi": "जल और निकासी", "mr": "पाणी व निचरा" }
    },
    {
      "key": "water_leak",
      "parent_key": "water",
      "display_name": "Water pipeline leak",
      "icon": "water",
      "sort_order": 31,
      "severity_semantics": { "floor": 3.0, "multiplier": 1.2 },
      "routing_hints": { "department_code": "WATER", "default_sla_tier": "high" },
      "translations": { "hi": "जल पाइपलाइन रिसाव", "mr": "जलवाहिनी गळती" }
    },
    {
      "key": "waterlogging",
      "parent_key": "water",
      "display_name": "Waterlogging",
      "sort_order": 32,
      "severity_semantics": { "floor": 4.0, "multiplier": 1.3 },
      "routing_hints": { "department_code": "WATER", "default_sla_tier": "high" },
      "translations": { "hi": "जलभराव", "mr": "पाणी साचणे" }
    },
    {
      "key": "streetlight_out",
      "display_name": "Street light not working",
      "icon": "lamp",
      "sort_order": 40,
      "routing_hints": { "department_code": "ELEC", "default_sla_tier": "medium" },
      "translations": { "hi": "स्ट्रीट लाइट बंद", "mr": "पथदिवा बंद" }
    },
    {
      "key": "exposed_cable",
      "display_name": "Exposed electrical cable",
      "sort_order": 41,
      "severity_semantics": { "floor": 9.0, "multiplier": 1.0, "bypasses_scoring": true },
      "routing_hints": { "department_code": "EMG", "default_sla_tier": "urgent" },
      "translations": { "hi": "खुला बिजली का तार", "mr": "उघडी वीज तार" }
    }
  ],

  "prompt_sets": [
    {
      "node_key": "pothole",
      "locale": "en",
      "encoder": "clip",
      "prompt_set_version": "municipality-1.0.0",
      "prompts": [
        "a photo of a pothole in a road surface",
        "a damaged asphalt road with a deep hole",
        "a broken road with a crater filled with water"
      ],
      "negative_prompts": [
        "a photo of an intact smooth road",
        "a photo of a manhole cover set into a road"
      ]
    },
    {
      "node_key": "garbage_pile",
      "locale": "en",
      "encoder": "clip",
      "prompt_set_version": "municipality-1.0.0",
      "prompts": [
        "a photo of a pile of uncollected garbage on a street",
        "overflowing rubbish bins on a pavement",
        "a heap of household waste dumped at a roadside"
      ],
      "negative_prompts": ["a photo of a clean empty street", "a closed municipal waste bin"]
    },
    {
      "node_key": "streetlight_out",
      "locale": "en",
      "encoder": "clip",
      "prompt_set_version": "municipality-1.0.0",
      "prompts": [
        "a photo of a street light that is switched off at night",
        "a dark street with an unlit lamp post",
        "a broken street lamp fixture"
      ],
      "negative_prompts": ["a photo of a brightly lit street at night"]
    },
    {
      "node_key": "water_leak",
      "locale": "en",
      "encoder": "clip",
      "prompt_set_version": "municipality-1.0.0",
      "prompts": [
        "a photo of water leaking from a burst pipe in a street",
        "water gushing out of a broken water main",
        "a flooded road caused by a pipeline leak"
      ],
      "negative_prompts": ["a photo of a dry road surface", "a photo of rain falling on a street"]
    },
    {
      "node_key": "open_manhole",
      "locale": "en",
      "encoder": "clip",
      "prompt_set_version": "municipality-1.0.0",
      "prompts": [
        "a photo of an open manhole with no cover",
        "a missing drain cover leaving an open hole in the pavement"
      ],
      "negative_prompts": ["a photo of a closed manhole cover flush with the road"]
    },
    {
      "node_key": "exposed_cable",
      "locale": "en",
      "encoder": "clip",
      "prompt_set_version": "municipality-1.0.0",
      "prompts": [
        "a photo of exposed live electrical cables hanging in a street",
        "a damaged electrical junction box with bare wires"
      ],
      "negative_prompts": ["a photo of a sealed electrical distribution box"]
    }
  ],

  "translations": [
    {
      "namespace": "zone",
      "locale": "mr",
      "entries": {
        "CITY": "शहर",
        "Z-EAST": "पूर्व विभाग",
        "Z-WEST": "पश्चिम विभाग",
        "W-01": "प्रभाग १",
        "W-02": "प्रभाग २",
        "W-03": "प्रभाग ३",
        "W-04": "प्रभाग ४"
      }
    },
    {
      "namespace": "zone",
      "locale": "hi",
      "entries": {
        "CITY": "शहर",
        "Z-EAST": "पूर्वी क्षेत्र",
        "Z-WEST": "पश्चिमी क्षेत्र",
        "W-01": "वार्ड 1",
        "W-02": "वार्ड 2",
        "W-03": "वार्ड 3",
        "W-04": "वार्ड 4"
      }
    }
  ]
}
