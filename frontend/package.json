{
  "name": "nemesis-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "NEMESIS Track E — the citizen, public, console and developer surfaces. Direction: NEMESIS-Frontend-Blueprint.md. Sequence: docs/FRONTEND-EXECUTION-PLAN.md.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "storybook": "storybook dev -p 6006 --no-open",
    "storybook:build": "storybook build --quiet",
    "storybook:diff": "node scripts/storybook-diff.ts",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "tokens": "node scripts/generate-tokens.ts",
    "tokens:check": "node scripts/generate-tokens.ts --check",
    "honesty": "node scripts/generate-honesty.ts",
    "honesty:check": "node scripts/generate-honesty.ts --check",
    "camera": "node scripts/generate-camera-track.ts",
    "camera:check": "node scripts/generate-camera-track.ts --check",
    "fonts:check": "python scripts/fetch_fonts.py --verify",
    "api:types": "node scripts/generate-api-types.ts",
    "api:types:check": "node scripts/generate-api-types.ts --check",
    "guards": "node scripts/check-guards.ts",
    "screens": "node scripts/capture-product-shots.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run tokens:check && npm run honesty:check && npm run camera:check && npm run fonts:check && npm run api:types:check && npm run guards && npm run typecheck && npm run lint && npm run format:check && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.102.2",
    "@theatre/core": "^0.7.2",
    "deck.gl": "^9.3.10",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "maplibre-gl": "^5.24.0",
    "next": "16.3.2",
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.14",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@next/eslint-plugin-next": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@storybook/nextjs-vite": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@theatre/studio": "^0.7.2",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "openapi-typescript": "^7.13.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "r3f-perf": "^7.2.3",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
